---
import { copy } from '../content/copy';
---

<!-- Fixed top right inside the sheet border (see .theme-switch in global.css). Needs JS to
     work, so it is hidden until the script reveals it. -->
<button
  type="button"
  role="switch"
  aria-checked="false"
  class="label theme-switch"
  data-theme-toggle
  hidden
>
  <span>{copy.prefs.lightMode}</span>
  <span class="theme-switch-track" aria-hidden="true">
    <span class="theme-switch-thumb"></span>
  </span>
</button>

<script>
  import {
    getTheme,
    setTheme,
    subscribeTheme,
    followOsTheme,
  } from '../lib/prefs';

  followOsTheme();
  document
    .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
    .forEach((btn) => {
      const sync = (t: 'blue' | 'paper') =>
        btn.setAttribute('aria-checked', String(t === 'paper'));
      sync(getTheme());
      subscribeTheme(sync);
      btn.addEventListener('click', () =>
        setTheme(getTheme() === 'paper' ? 'blue' : 'paper'),
      );
      btn.hidden = false;
    });
</script>
