---
import { getCopy } from '../content';
import type { CvRow } from '../content/schema';

/** Roles and dates as a table; the date cell is the row header. Named by the section heading. */
interface Props {
  rows: CvRow[];
}
const { rows } = Astro.props;
const { cv } = getCopy();
---

<table class="cv-table" aria-labelledby="cv-heading">
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row" class="label">
          {r.when}
        </th>
        <td>
          {r.role}
          {r.details && r.details.length > 0 && (
            <ul class="cv-details small">
              {r.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          )}
        </td>
        <td>{r.org}</td>
      </tr>
    ))}
    <tr>
      <th scope="row" class="label">
        {cv.skillsLabel}
      </th>
      <td colspan="2">{cv.skills}</td>
    </tr>
  </tbody>
</table>
