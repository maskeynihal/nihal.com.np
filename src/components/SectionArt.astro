---
/**
 * The art behind the sheet: one fixed canvas, decoration only (aria-hidden, no text, no layout
 * space, no pointer events). The drawings fill the empty column of each section that has an `art`
 * prop; the engine (src/lib/side-art) measures them from the markup and draws from 1024 px.
 * Hidden below 1024 px, in print, and without JS.
 */
---

<canvas class="side-art" aria-hidden="true" data-print="hide"></canvas>

<script>
  // Tiny and eager. The engine is a separate chunk, fetched once the page is idle and only on a wide
  // screen; narrowing and widening later still loads it.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.side-art');
  const mq = matchMedia('(min-width: 1024px)');
  if (canvas) {
    let started = false;
    const start = () => {
      if (started || !mq.matches) return;
      started = true;
      void import('../lib/section-art').then((m) => m.mountSideArt(canvas));
    };
    const idle = () => {
      if ('requestIdleCallback' in window)
        requestIdleCallback(start, { timeout: 4000 });
      else setTimeout(start, 1500);
    };
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
    mq.addEventListener('change', idle);
  }
</script>
