---
import '../../styles/garden.css';
---

<section class="garden" aria-label="garden" data-garden data-print="hide">
  <canvas class="garden-canvas" aria-hidden="true"></canvas>
  <div class="garden-foot">
    <p class="garden-caption small">
      the garden. pick flowers for the bucket. throw the ball for the dogs.
    </p>
    <p class="garden-count small" aria-live="polite" data-garden-count>
      the bucket is empty
    </p>
    <div class="garden-actions">
      <button type="button" class="garden-btn label" data-garden-pick>
        pick a flower
      </button>
      <button type="button" class="garden-btn label" data-garden-throw>
        throw a ball
      </button>
      <button type="button" class="garden-btn label" data-garden-new hidden>
        start a new bouquet
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-garden]');
  if (root) {
    const io = new IntersectionObserver(
      (es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../lib/garden/garden').then((m) => m.mountGarden(root));
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(root);
  }
</script>
