---
import '../../styles/garden.css';
---

<section class="garden" aria-label="garden" data-garden data-print="hide">
  <canvas class="garden-canvas" aria-hidden="true"></canvas>
  <div class="garden-foot">
    <p class="garden-count sr-only" aria-live="polite" data-garden-count>
      the bucket is empty
    </p>
    <div class="garden-actions">
      <button
        type="button"
        class="garden-btn"
        data-garden-act="pick"
        aria-label="pick a flower"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="1.6"></circle>
          <path d="M12 6.4c-1-3.2 2.8-3.6 0 0m1.6 1.6c3.2-1 3.6 2.8 0 0m-1.6 1.6c1 3.2-2.8 3.6 0 0M10.4 8c-3.2 1-3.6-2.8 0 0"></path>
          <path d="M12 9.8V21m0-5c-3 0-4-2-4-3.5 2.2 0 4 1 4 3.5z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="throw"
        aria-label="throw a ball"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5"></circle>
          <path d="M5.2 6.8c3.6 2.6 3.6 8 0 10.4M18.8 6.8c-3.6 2.6-3.6 8 0 10.4"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="new"
        aria-label="start a new bouquet"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 11h8l-1 8H9zM9 11c0-1 6-1 6 0"></path>
          <path d="M19.5 9A8 8 0 0 0 5 7.5M4.5 15a8 8 0 0 0 14.5 1.5"></path>
          <path d="M5 3.5v4h4M19 20.5v-4h-4"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="wrap"
        aria-label="wrap the bouquet"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 9l13-4 5 6-12 5zM16 5l.5 5.5L21 11"></path>
          <path d="M9 16l-1 4 3-2 2 2 .5-4.5"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="vase"
        aria-label="put the bouquet in the vase"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 4h6M10 4c0 3-3 4-3 8 0 4 1 7 2 8h6c1-1 2-4 2-8 0-4-3-5-3-8"></path>
          <path d="M12 2v5M10 5l2 2 2-2"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="drop"
        aria-label="drop the bouquet to the bottom of the screen"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3v12M7.5 10.5L12 15l4.5-4.5M5 20h14"></path>
        </svg>
      </button>
      <button
        type="button"
        class="garden-btn"
        data-garden-act="out"
        aria-label="take the bouquet out of the vase"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 12h6M10 12c0 2-3 2-3 5 0 2 1 4 2 4h6c1 0 2-2 2-4 0-3-3-3-3-5"></path>
          <path d="M12 2v7M9 5l3-3 3 3"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-garden]');
  if (root) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      io.disconnect();
      import('../../lib/garden/garden').then((m) => m.mountGarden(root));
    };
    const io = new IntersectionObserver(
      (es) => {
        if (es.some((e) => e.isIntersecting)) start();
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(root);
    // Something left at the bottom of the screen comes back with the page, without waiting for the garden to scroll near.
    try {
      if (
        /"k":"[bv]"|"p":\[\{/.test(localStorage.getItem('nihal:bouquets') ?? '')
      )
        start();
    } catch {
      // Storage can be blocked.
    }
  }
</script>
