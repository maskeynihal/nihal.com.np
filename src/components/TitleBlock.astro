---
import { getCopy } from '../content';
import CopyEmail from './CopyEmail.astro';
import MotionToggle from './MotionToggle.astro';
import SoundToggle from './SoundToggle.astro';

/**
 * The drawing's title block (design 3, #desk): name as the page's only h1, one sentence, the
 * address and the live Kathmandu time. Everything but the minute is plain
 * server-rendered text, so it is the first paint and the LCP element. The time is filled in by
 * the script below.
 * No card: the block sits on the page itself, the same surface the 3D desk is drawn on, so
 * text and drawing read as one title sheet (styles: content.css, phone.css).
 */
const { titleBlock } = getCopy();
---

<div class="title-block">
  <h1 id="name" class="name">
    {titleBlock.name}
  </h1>
  <p class="title-block-kicker label">{titleBlock.kicker}</p>
  <p class="title-block-line">{titleBlock.line}</p>
  <div class="title-block-side">
    <ul class="label title-block-rows">
      <li>
        <CopyEmail />
      </li>
      <li>
        <a class="sheet-link" href="#projects" data-glide>
          {titleBlock.seeProjects}
        </a>
      </li>
      <li class="title-block-clock">
        <time class="live-time" data-live-time></time> {titleBlock.timeLabel}
      </li>
    </ul>
    <div class="title-block-prefs">
      <MotionToggle />
      <SoundToggle />
    </div>
  </div>
</div>

<script>
  import { everyMinute, formatClock } from '../lib/time';

  const els = document.querySelectorAll<HTMLTimeElement>('[data-live-time]');
  everyMinute((now) => {
    for (const el of els) {
      el.textContent = formatClock(now);
      el.dateTime = now.toISOString();
    }
  });
</script>
