---
import posterSvg from '../assets/poster.svg?raw';
import { getCopy, getObjects } from '../content';
import { buildPosterAlt } from '../content/poster-alt';

/**
 * The line drawing of the desk (D-01 poster, projected from the same models as the 3D scene),
 * inlined so it paints with the HTML: no request, no JS. `role="img"` with a description built
 * from the objects actually shown. It is also the fallback for every no-3D path; the Desk island
 * only sets `data-desk-state` on the wrapping figure. The script below makes the poster `inert`
 * while the canvas is live (the object list is the keyboard path) and restores it otherwise.
 *
 * Everything the live canvas needs to say is plain HTML here, hidden (`visibility`, so nothing
 * moves) until `data-desk-state="live"`: the drag hint and the reset button.
 */
const { titleBlock } = getCopy();
const alt = buildPosterAlt(getObjects()).replaceAll('"', '&quot;');
const svg = posterSvg
  .trim()
  .replace(
    '<svg ',
    `<svg class="poster" role="img" aria-label="${alt}" focusable="false" `,
  );
---

<div class="poster-frame" data-poster set:html={svg} />
<div class="desk-controls" data-desk-controls>
  <p class="label desk-hint">{titleBlock.dragHint}</p>
  <button type="button" class="label desk-reset" data-desk-reset>
    {titleBlock.reset}
  </button>
</div>

<script>
  const frame = document.querySelector<HTMLElement>('[data-poster]');
  const figure = frame?.closest<HTMLElement>('[data-desk]');
  if (frame && figure) {
    const sync = () => {
      frame.inert = figure.dataset['deskState'] === 'live';
    };
    sync();
    new MutationObserver(sync).observe(figure, {
      attributes: true,
      attributeFilter: ['data-desk-state'],
    });
  }
</script>
