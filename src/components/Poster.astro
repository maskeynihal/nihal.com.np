---
import { getObjects } from '../content';
import { buildPosterAlt } from '../content/poster-alt';

// PLACEHOLDER (A-10): D-03 swaps this body for the generated poster SVG (<= 16 KB).
// Keep the contract: inline SVG, role="img", alt derived from the shown objects,
// visible without JS. The Desk island toggles state on the wrapping figure only.
const alt = buildPosterAlt(getObjects());
---

<svg
  class="poster"
  role="img"
  aria-label={alt}
  viewBox="0 0 640 360"
  width="640"
  height="360"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect x="236" y="150" width="168" height="110" rx="4"></rect>
  <rect x="290" y="176" width="60" height="32"></rect>
  <circle cx="120" cy="110" r="46"></circle>
  <path d="M120 110V76M120 110l22 12"></path>
  <rect x="470" y="70" width="110" height="96" rx="4"></rect>
  <path d="M470 98h110"></path>
  <path d="M470 280a30 30 0 0 1 60 0v34l-12-8-12 8-12-8-12 8-12-8z"></path>
</svg>
