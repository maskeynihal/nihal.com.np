---
import posterSvg from '../assets/poster.svg?raw';
import posterPhoneSvg from '../assets/poster-phone.svg?raw';
import { phoneObjectIds } from '../lib/desk/phone';
import { getCopy, getObjects } from '../content';
import { buildPosterAlt } from '../content/poster-alt';

/**
 * The line drawing of the desk (D-01 poster, projected from the same models as the 3D scene),
 * inlined so it paints with the HTML: no request, no JS. `role="img"` with a description built
 * from the objects actually shown. It is also the fallback for every no-3D path; the Desk island
 * only sets `data-desk-state` on the wrapping figure. The script below makes the poster `inert`
 * while the canvas is live (the object list is the keyboard path) and restores it otherwise.
 *
 * Everything the live canvas needs to say is plain HTML here, hidden (`visibility`, so nothing
 * moves) until `data-desk-state="live"`: the reset button.
 * The Scene chunk must not import `content/objects.ts` (unconfirmed objects would ship in it),
 * so the shown objects are handed to it as `data-objects`: the confirmed ones only, with their
 * pose, collider, mass and target (everything the physics needs).
 * The script below also owns `nihal:navigate`: the one scroll owner (design 5, impl spec 4).
 */
const { titleBlock } = getCopy();
const objects = JSON.stringify(
  getObjects().map((o) => ({
    id: o.id,
    model: o.model.replace(/\.glb$/, ''),
    p: o.home.p,
    q: o.home.q,
    collider: o.collider,
    mass: o.mass,
    ...(o.target ? { target: o.target } : {}),
  })),
);
// Two drawings, each projected through its own camera: the wide table, and the portrait view with
// fewer objects below 768 px. CSS shows one; the other is `display: none`, so it is neither painted
// nor in the accessibility tree.
const asSvg = (
  raw: string,
  cls: string,
  shown: ReturnType<typeof getObjects>,
) =>
  raw
    .trim()
    .replace(
      '<svg ',
      `<svg class="poster ${cls}" role="img" aria-label="${buildPosterAlt(shown).replaceAll('"', '&quot;')}" focusable="false" `,
    );
// The drawing follows the theme: it strokes in `currentColor` (the `.poster` rule sets it to
// the --stroke token).
const svg =
  asSvg(posterSvg, 'poster-wide', getObjects()) +
  asSvg(
    posterPhoneSvg,
    'poster-phone',
    getObjects().filter((o) => phoneObjectIds.has(o.id)),
  );
---

<div class="poster-frame" data-poster data-objects={objects} set:html={svg} />
<div class="desk-controls" data-desk-controls>
  <button
    type="button"
    class="desk-reset"
    data-desk-reset
    aria-label={titleBlock.reset}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3" />
      <path d="M4.2 3.6v3.9h3.9" />
    </svg>
  </button>
</div>

<script>
  const frame = document.querySelector<HTMLElement>('[data-poster]');
  const figure = frame?.closest<HTMLElement>('[data-desk]');
  if (frame && figure) {
    const sync = () => {
      frame.inert = figure.dataset['deskState'] === 'live';
    };
    sync();
    new MutationObserver(sync).observe(figure, {
      attributes: true,
      attributeFilter: ['data-desk-state'],
    });
  }

  // A drawn object was tapped: scroll to its section and put focus on the section's heading.
  // Smooth only when motion is on; no global `scroll-behavior` (it would fight the sheet index).
  window.addEventListener('nihal:navigate', (e) => {
    const target = (e as CustomEvent<unknown>).detail;
    if (typeof target !== 'string' || !/^#[\w-]+$/.test(target)) return;
    const section = document.querySelector<HTMLElement>(target);
    if (!section) return;
    const smooth = document.documentElement.dataset['motion'] === 'full';
    section.scrollIntoView({
      behavior: smooth ? 'smooth' : 'auto',
      block: 'start',
    });
    const heading = section.querySelector<HTMLElement>('h1, h2, h3') ?? section;
    if (!heading.hasAttribute('tabindex')) heading.tabIndex = -1;
    heading.focus({ preventScroll: true });
  });
</script>
