---
import type { WorkItem } from '../content/schema';
import { splitDateLine } from '../lib/dates';
import PaperPanel from './PaperPanel.astro';
import ArcadePanel from './ArcadePanel.astro';

const marks = import.meta.glob<string>('../assets/marks/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

/**
 * One work panel: anchor `work-<id>` (desk objects link here), heading, a mono date line
 * (what happened, when), prose and real links. All plain HTML. An item with a `frameNote`
 * (client work with no code) also gets an empty drawing frame whose title block is filled in.
 * Each panel carries one hand-drawn mark (src/assets/marks/<id>.svg, currentColor): already drawn,
 * decorative, never animated.
 */
interface Props {
  item: WorkItem;
}
const { item } = Astro.props;
// pathLength=1 lets the hover redraw animate stroke-dashoffset on any path.
const mark = marks[`../assets/marks/${item.id}.svg`];
if (!mark) throw new Error(`no mark for work item ${item.id}`);
const headingId = `work-${item.id}-heading`;
const { date, rest } = splitDateLine(item.dateLine);
---

<PaperPanel as="article" id={`work-${item.id}`} class="work-panel">
  <div
    class="work-mark"
    aria-hidden="true"
    data-mark={item.id}
    set:html={mark.replaceAll('<path', '<path pathLength="1"')}
  />
  <h3 id={headingId}>{item.title}</h3>
  <p class="label work-date">
    {date ? (
      <time datetime={date.datetime} data-date-line>
        {date.text}
      </time>
    ) : null}
    {rest}
  </p>
  <p class="label work-meta">{item.meta}</p>
  {item.body.map((p) => (
    <p>{p}</p>
  ))}
  {item.frameNote && (
    <figure class="drawing-frame">
      <figcaption>
        <span class="label">{item.title}</span>
        <span>{item.frameNote}</span>
      </figcaption>
    </figure>
  )}
  {item.arcade && <ArcadePanel title={item.title} href={item.arcade.href} />}
  {item.links.length > 0 && (
    <ul class="label sheet-links">
      {item.links.map((l) => (
        <li>
          <a href={l.href} rel="noopener">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  )}
</PaperPanel>
