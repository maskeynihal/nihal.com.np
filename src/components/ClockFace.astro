---
import { formatClock } from '../lib/time';
import { handAngles, utcOffsetLabel } from '../lib/clock';

/**
 * One contact clock (design 3, #contact): a 2D face plus the digital time. The server renders
 * the city, the UTC offset and the time as of the build, so the zone names read with scripts
 * off; the script below corrects the time, hands and offset on every minute boundary. The
 * face is decorative (`aria-hidden`); the `<time>` is the accessible reading. No animation.
 */
interface Props {
  city: string;
  timeZone: string;
}
const { city, timeZone } = Astro.props;
const now = new Date();
const { hour, minute } = handAngles(now, timeZone);
const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<figure class="clock" data-clock data-tz={timeZone}>
  <svg
    class="clock-face"
    viewBox="0 0 100 100"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="50" cy="50" r="46"></circle>
    {ticks.map((a) => (
      <line
        class="clock-tick"
        x1="50"
        y1="8"
        x2="50"
        y2={a % 90 === 0 ? '16' : '12'}
        transform={`rotate(${a} 50 50)`}
      />
    ))}
    <line
      class="clock-hand"
      data-hand="hour"
      x1="50"
      y1="50"
      x2="50"
      y2="28"
      transform={`rotate(${hour} 50 50)`}
    ></line>
    <line
      class="clock-hand"
      data-hand="minute"
      x1="50"
      y1="50"
      x2="50"
      y2="17"
      transform={`rotate(${minute} 50 50)`}
    ></line>
  </svg>
  <figcaption class="label">
    <span class="clock-city">{city}</span>
    <span class="clock-reading">
      <time datetime={now.toISOString()} data-clock-time>
        {formatClock(now, timeZone)}
      </time>
      <span data-clock-offset>{utcOffsetLabel(now, timeZone)}</span>
    </span>
  </figcaption>
</figure>

<script>
  import { everyMinute, formatClock } from '../lib/time';
  import { handAngles, utcOffsetLabel } from '../lib/clock';

  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  everyMinute((now) => {
    for (const el of clocks) {
      const tz = el.dataset['tz'];
      if (!tz) continue;
      const { hour, minute } = handAngles(now, tz);
      el.querySelector('[data-hand="hour"]')?.setAttribute(
        'transform',
        `rotate(${hour} 50 50)`,
      );
      el.querySelector('[data-hand="minute"]')?.setAttribute(
        'transform',
        `rotate(${minute} 50 50)`,
      );
      const t = el.querySelector<HTMLTimeElement>('[data-clock-time]');
      if (t) {
        t.textContent = formatClock(now, tz);
        t.dateTime = now.toISOString();
      }
      const off = el.querySelector('[data-clock-offset]');
      if (off) off.textContent = utcOffsetLabel(now, tz);
    }
  });
</script>
