---
import type { PR } from '../content/schema';
import { isDatetime } from '../lib/dates';
import { getCopy } from '../content';

/**
 * The open-source ledger as a revision table: repo, what, merged. A real `<table>` named by the
 * section heading. Month values become `<time datetime>`; ranges and bare years stay text.
 */
interface Props {
  rows: PR[];
}
const { rows } = Astro.props;
const { openSource } = getCopy();
const [repo, what, merged] = openSource.columns;
---

<table class="revision-table" aria-labelledby="open-source-heading">
  <thead>
    <tr>
      <th scope="col">{repo}</th>
      <th scope="col">{what}</th>
      <th scope="col">{merged}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">
          <a href={r.href} rel="noopener">
            {r.repo}
          </a>
        </th>
        <td>{r.what}</td>
        <td>
          {isDatetime(r.merged) ? (
            <time datetime={r.merged}>{r.merged}</time>
          ) : (
            r.merged
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
