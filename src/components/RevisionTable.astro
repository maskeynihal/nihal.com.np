---
import type { PR } from '../content/schema';
import { isDatetime } from '../lib/dates';
import { getCopy } from '../content';
import '../styles/projects.css';

/**
 * The open-source ledger as a revision table: repo, what, merged. A real `<table>` named by the
 * heading above it. One row per repo. Month values become `<time datetime>`; ranges and bare
 * years stay text. `own` tables (my projects) say "since" in the last column, not "merged".
 */
interface Props {
  rows: PR[];
  kind?: PR['kind'];
  /** id of the heading that names this table. */
  labelledby?: string;
}
const {
  rows,
  kind = 'contribution',
  labelledby = 'open-source-heading',
} = Astro.props;
const { openSource } = getCopy();
const [repo, what, mergedLabel] = openSource.columns;
const merged = kind === 'own' ? openSource.since : mergedLabel;
---

<table class="revision-table" aria-labelledby={labelledby}>
  <thead>
    <tr>
      <th scope="col">{repo}</th>
      <th scope="col">{what}</th>
      <th scope="col">{merged}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">
          <a href={r.href} rel="noopener">
            {r.repo}
          </a>
        </th>
        <td>{r.what}</td>
        <td>
          {isDatetime(r.merged) ? (
            <time datetime={r.merged}>{r.merged}</time>
          ) : (
            r.merged
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
