---
import '../styles/global.css';
import printCss from '../styles/print.css?url';
import PrefsScript from '../components/PrefsScript.astro';
import { getCopy } from '../content';
import { site } from '../content/site';
import { buildGraph, serializeLd } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Adds `noindex` and drops canonical/og:url (404, /sent). */
  noindex?: boolean;
  /** Renders the skip link to this id (index only). */
  skipTo?: string;
  /** Emits the JSON-LD graph and profile meta (index only). */
  jsonLd?: boolean;
}
const { meta, titleBlock } = getCopy();
const {
  title = meta.title,
  description = meta.description,
  noindex = false,
  skipTo,
  jsonLd = false,
} = Astro.props;
const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(site.og.image);
---

<!doctype html>
<html lang="en" data-motion="full" data-sound="off">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <PrefsScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    {jsonLd && <meta name="keywords" content={meta.keywords} />}
    <meta name="author" content={site.person.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content={jsonLd ? 'profile' : 'website'} />
    {jsonLd && (
      <>
        <meta property="profile:first_name" content={site.person.firstName} />
        <meta property="profile:last_name" content={site.person.lastName} />
      </>
    )}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(site.og.width)} />
    <meta property="og:image:height" content={String(site.og.height)} />
    <meta property="og:image:alt" content={meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={serializeLd(buildGraph())}
      />
    )}
    <link rel="stylesheet" href={printCss} media="print" />
  </head>
  <body>
    {skipTo && (
      <a class="skip-link" href={`#${skipTo}`}>
        {titleBlock.skip}
      </a>
    )}
    <slot />
    <script>
      import '../lib/test-hooks';
      import '../lib/analytics';
    </script>
  </body>
</html>
