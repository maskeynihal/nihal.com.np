---
import Base from '../layouts/Base.astro';
import { testHooks } from '../lib/env';
import TitleBlock from '../components/TitleBlock.astro';
import ObjectList from '../components/ObjectList.astro';
import Poster from '../components/Poster.astro';
import Garden from '../components/garden/Garden.astro';
import Desk from '../components/desk/Desk';
import Section from '../components/Section.astro';
import PaperPanel from '../components/PaperPanel.astro';
import SheetBorder from '../components/SheetBorder.astro';
import SheetIndex from '../components/SheetIndex.astro';
import WorkPanel from '../components/WorkPanel.astro';
import RevisionTable from '../components/RevisionTable.astro';
import WritingList from '../components/WritingList.astro';
import CvTable from '../components/CvTable.astro';
import CopyEmail from '../components/CopyEmail.astro';
import ContactForm from '../components/ContactForm';
import ClockFace from '../components/ClockFace.astro';
import {
  getCopy,
  getWork,
  getOss,
  getWriting,
  getCv,
  getClocks,
  getEndMark,
} from '../content';
import { site } from '../content/site';
import { rowLabel } from '../lib/sections';

const { titleBlock, headings, writing, cv, contact, colophon } = getCopy();
const work = getWork();
const oss = getOss();
const posts = getWriting();
const cvRows = getCv();
const clocks = getClocks();
const endMark = getEndMark();
const year = String(new Date().getFullYear());
---

<Base skipTo="work" jsonLd>
  <SheetBorder />
  <SheetIndex />
  <main class="sheet">
    <Section id="desk" side="full" labelledBy="name">
      <div class="desk-stage">
        <TitleBlock />
        <!-- The poster is plain HTML and visible by default. The Desk island only sets
             data-desk-state (poster | live | failed) and the status note. -->
        <figure class="desk" data-desk data-desk-state="poster">
          <Poster />
          <Desk client:only="react" />
        </figure>
        <ObjectList />
      </div>
    </Section>

    <Section id="work" heading={headings.work} side="left">
      {work.map((item) => (
        <WorkPanel item={item} />
      ))}
    </Section>

    <Section id="open-source" heading={headings.openSource} side="right">
      <PaperPanel>
        <RevisionTable rows={oss} />
      </PaperPanel>
    </Section>

    <Section id="writing" heading={headings.writing} side="left">
      <p>{writing.intro}</p>
      <PaperPanel>
        <WritingList posts={posts} />
      </PaperPanel>
    </Section>

    <Section id="cv" heading={headings.cv} side="right">
      <p>{cv.note}</p>
      <PaperPanel>
        <CvTable rows={cvRows} />
      </PaperPanel>
    </Section>

    <Section id="contact" heading={headings.contact} side="left">
      <PaperPanel class="contact-panel">
        <p>{contact.lead}</p>
        <p>
          <CopyEmail />
        </p>
        <ul class="clocks">
          {clocks.map((c) => (
            <li>
              <ClockFace city={c.city} timeZone={c.timeZone} />
            </li>
          ))}
        </ul>
        <p class="small">{contact.overlap}</p>
        <ContactForm
          client:visible
          action={`https://formspree.io/f/${site.formspreeId}`}
          next={`${site.url}/sent/`}
          address={titleBlock.email}
          labels={contact.form}
          success={contact.success}
          errors={contact.errors}
        />
        <ul class="sheet-links label">
          {contact.socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </PaperPanel>
    </Section>

    <Garden />

    <!-- B-07 closes the sheet under the colophon. -->
    <Section id="colophon" heading={rowLabel('colophon')} side="right">
      <p class="small">{colophon.copyright.replace('{year}', year)}</p>
      <p class="small">
        <a class="sheet-link" href={colophon.sourceHref} rel="noopener">
          {colophon.source}
        </a>
      </p>
      {endMark && (
        <p class="small end-mark" lang={endMark.lang}>
          {endMark.text}
        </p>
      )}
    </Section>

    {testHooks && (
      <div
        id="motion-probe"
        aria-hidden="true"
        style="transition: transform 2s; margin-top: 1rem"
      />
    )}

    <!-- The sheet closes here: the drawing's bottom rule meets the border (B-07). -->
    <div class="sheet-close" aria-hidden="true" data-print="hide"></div>
  </main>
</Base>
