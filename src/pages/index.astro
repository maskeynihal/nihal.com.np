---
import Base from '../layouts/Base.astro';
import { testHooks } from '../lib/env';
import TitleBlock from '../components/TitleBlock.astro';
import ObjectList from '../components/ObjectList.astro';
import Poster from '../components/Poster.astro';
import Desk from '../components/desk/Desk';
import Section from '../components/Section.astro';
import PaperPanel from '../components/PaperPanel.astro';
import SheetBorder from '../components/SheetBorder.astro';
import SheetIndex from '../components/SheetIndex.astro';
import { getCopy } from '../content';
import { rowLabel } from '../lib/sections';

const { titleBlock, headings, openSource, writing, cv, contact, colophon } =
  getCopy();
const year = String(new Date().getFullYear());
---

<Base skipTo="work" jsonLd>
  <SheetBorder />
  <SheetIndex />
  <main class="sheet">
    <Section id="desk" side="full" labelledBy="name">
      <div class="desk-stage">
        <TitleBlock />
        <!-- The poster is plain HTML and visible by default. The Desk island only sets
             data-desk-state (poster | live | failed) and the status note. -->
        <figure class="desk" data-desk data-desk-state="poster">
          <Poster />
          <Desk client:only="react" />
        </figure>
        <ObjectList />
      </div>
    </Section>

    <!-- work, open-source, writing and cv: headed sections; B-04 fills them with panels and tables. -->
    <Section id="work" heading={headings.work} side="left" />

    <Section id="open-source" heading={headings.openSource} side="right">
      <p>{openSource.intro}</p>
    </Section>

    <Section id="writing" heading={headings.writing} side="left">
      <p>{writing.intro}</p>
    </Section>

    <Section id="cv" heading={headings.cv} side="right">
      <p>{cv.note}</p>
    </Section>

    <!-- B-06a adds the clocks and copy button, B-06b the form. -->
    <Section id="contact" heading={headings.contact} side="left">
      <PaperPanel>
        <p>{contact.lead}</p>
        <p class="page-sheet-contact">
          <a href={`mailto:${titleBlock.email}`}>{titleBlock.email}</a>
        </p>
        <p class="small">{contact.overlap}</p>
        <ul class="sheet-links label">
          {contact.socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </PaperPanel>
    </Section>

    <!-- B-07 closes the sheet under the colophon. -->
    <Section id="colophon" heading={rowLabel('colophon')} side="right">
      <p class="small">{colophon.copyright.replace('{year}', year)}</p>
      <p class="small">
        <a href={colophon.sourceHref} rel="noopener">
          {colophon.source}
        </a>
      </p>
    </Section>

    {testHooks && (
      <div
        id="motion-probe"
        aria-hidden="true"
        style="transition: transform 2s; margin-top: 1rem"
      />
    )}
  </main>
</Base>
