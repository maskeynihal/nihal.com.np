{
  "name": "nihal-com-np",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "build:e2e": "cross-env PUBLIC_TEST_HOOKS=1 astro build",
    "check:graph": "tsx scripts/check-initial-graph.ts",
    "review": "tsx scripts/review.ts",
    "review:all": "tsx scripts/review.ts --all",
    "fonts": "tsx scripts/fonts/build-fonts.ts",
    "lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "7.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@capsizecss/metrics": "^4.4.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "es-module-lexer": "^3.0.4",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
